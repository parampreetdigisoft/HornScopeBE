@model HornScope.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>@Model.Title</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body bgcolor="#FFFFFF" style="margin:0;padding:0;background-color:#FFFFFF;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
        Your HornScope evaluator account is now active.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background-color:#FFFFFF;padding:32px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;margin:0 auto;background-color:#0C2238;border:1px solid #1E3D5C;border-radius:14px;overflow:hidden;">

                    <tr>
                        <td height="4" bgcolor="#C5A05A" style="height:4px;background-color:#C5A05A;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td align="center" bgcolor="#002147" style="background-color:#002147;padding:32px 28px 28px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 18px;">
                                <tr>
                                    <td bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:12px;padding:10px 14px;">
                                        <img src="cid:hs-logo"
                                             alt="HornScope"
                                             width="168"
                                             style="display:block;width:168px;max-width:100%;height:auto;border:0;" />
                                    </td>
                                </tr>
                            </table>
                            <div style="font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C5A05A;margin-bottom:8px;">
                                HornScope
                            </div>  
                            <div style="font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1.35;font-weight:700;color:#D4B86A;text-align:center;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#0C2238" style="background-color:#0C2238;padding:32px 36px 24px;font-size:15px;line-height:1.7;color:#E8EEF4;">
                            <p style="margin:0 0 16px;color:#E8EEF4;">@Model.Name,</p>
                            <p style="margin:0 0 16px;color:#B8C5D0;">
                                Your evaluator account for the <strong style="color:#E8EEF4;">HornScope</strong> platform has been activated.
                                You have been added to the evaluation workspace for the countries assigned to you and may now begin reviewing submissions from the analysts.
                            </p>
                            <p style="margin:0 0 8px;color:#B8C5D0;">Please use the secure link below to create your password and access your evaluator dashboard:</p>

                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:24px auto;">
                                <tr>
                                    <td align="center" bgcolor="#C5A05A" style="background-color:#C5A05A;border-radius:10px;">
                                        <a href="@Model.ResetPasswordUrl"
                                           style="display:inline-block;padding:14px 28px;background-color:#C5A05A;color:#002147;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:0.02em;border-radius:10px;">
                                            Set Your Password
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 12px;font-weight:700;color:#D4B86A;">As an evaluator, you will be able to:</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;">
                                <tr>
                                    <td style="padding:16px 18px;background-color:#123049;border-left:3px solid #C5A05A;border-radius:8px;color:#E8EEF4;font-size:14px;line-height:1.75;">
                                        • Review country assessment inputs submitted by analysts<br />
                                        • Score indicators and provide required narrative comments<br />
                                        • Coordinate directly with analysts for each assigned country<br />
                                        • Submit your completed evaluations for administrative review
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 16px;color:#B8C5D0;">
                                If you already have an active password, simply log in and proceed with your evaluation tasks.
                            </p>
                            <p style="margin:0 0 16px;color:#B8C5D0;">
                                For support or technical issues, please contact
                                <a href="mailto:@Model.Mail" style="color:#D4B86A;font-weight:700;text-decoration:none;">@Model.Mail</a>.
                            </p>
                            <p style="margin:0;color:#B8C5D0;">Thank you for contributing to the HornScope evaluation process.</p>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#061525" style="background-color:#061525;padding:22px 36px 28px;border-top:1px solid #1E3D5C;font-size:14px;">
                            <p style="margin:0 0 4px;color:#8FA3B5;">Warm regards,</p>
                            <p style="margin:0;color:#D4B86A;font-weight:700;">HornScope - Platform Administration</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
