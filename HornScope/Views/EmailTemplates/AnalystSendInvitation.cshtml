@model HornScope.Views.EmailModels.EmailInvitationSendRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>@Model.Title</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body bgcolor="#FFFFFF" style="margin:0;padding:0;background-color:#FFFFFF;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
        Your Africa Market Intelligence analyst account is now active.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background-color:#FFFFFF;padding:32px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;margin:0 auto;background-color:#1B1810;border:1px solid #332C1D;border-radius:14px;overflow:hidden;">

                    <tr>
                        <td height="4" bgcolor="#C9A24A" style="height:4px;background-color:#C9A24A;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td align="center" bgcolor="#0A0906" style="background-color:#0A0906;padding:36px 28px 28px;">
                            <img src="cid:ami-logo"
                                 alt="Africa Market Intelligence"
                                 width="200"
                                 style="display:block;width:200px;max-width:80%;height:auto;margin:0 auto 22px;border:0;" />
                            <div style="font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C9A24A;margin-bottom:14px;">
                                Africa Market Intelligence
                            </div>
                            <div style="font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1.35;font-weight:700;color:#E7C878;text-align:center;">
                                @Model.Title
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#1B1810" style="background-color:#1B1810;padding:32px 36px 24px;font-size:15px;line-height:1.7;color:#EFE7D6;">
                            <p style="margin:0 0 16px;color:#EFE7D6;">@Model.Name,</p>
                            <p style="margin:0 0 16px;color:#C9C7BF;">
                                Your analyst account for the <strong style="color:#EFE7D6;">Africa Market Intelligence (AMI)</strong> platform is now active.
                                You have been added to the assessment workspace for the countries assigned to you and can begin coordinating the evaluation process.
                            </p>
                            <p style="margin:0 0 8px;color:#C9C7BF;">Please use the secure link below to create your password and access your dashboard:</p>

                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:24px auto;">
                                <tr>
                                    <td align="center" bgcolor="#C9A24A" style="background-color:#C9A24A;border-radius:10px;">
                                        <a href="@Model.ResetPasswordUrl"
                                           style="display:inline-block;padding:14px 28px;background-color:#C9A24A;color:#0A0906;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:0.02em;border-radius:10px;">
                                            Set Your Password
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 12px;font-weight:700;color:#E7C878;">As an analyst, you will be able to:</p>
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px;">
                                <tr>
                                    <td style="padding:16px 18px;background-color:#141209;border-left:3px solid #C9A24A;border-radius:8px;color:#EFE7D6;font-size:14px;line-height:1.75;">
                                        ùï Complete and submit country assessment questionnaires<br />
                                        ïù Add or manage evaluators where needed<br />
                                        ùï Review submissions and prepare materials for administrative review
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 16px;color:#C9C7BF;">
                                If you already have an active password, simply log in and continue your work.
                            </p>
                            <p style="margin:0 0 16px;color:#C9C7BF;">
                                For assistance or system-related support, contact:
                                <a href="mailto:@Model.Mail" style="color:#E7C878;font-weight:700;text-decoration:none;">@Model.Mail</a>
                            </p>
                            <p style="margin:0;color:#C9C7BF;">Thank you for joining the assessment team.</p>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#141209" style="background-color:#141209;padding:22px 36px 28px;border-top:1px solid #332C1D;font-size:14px;">
                            <p style="margin:0 0 4px;color:#9C9484;">Warm regards,</p>
                            <p style="margin:0;color:#E7C878;font-weight:700;">Africa Market Intelligence ù Platform Administration</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
