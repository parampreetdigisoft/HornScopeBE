@model API.Views.EmailModels.UserEmailConfirmationRequestDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>Verify your email</title>
    <!--[if mso]>
    <noscript>
        <xml>
            <o:OfficeDocumentSettings>
                <o:PixelsPerInch>96</o:PixelsPerInch>
            </o:OfficeDocumentSettings>
        </xml>
    </noscript>
    <![endif]-->
</head>
<body bgcolor="#FFFFFF" style="margin:0;padding:0;background-color:#FFFFFF;font-family:Arial,'Helvetica Neue',Helvetica,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
        Confirm your HornScope email address to activate your account.
    </div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF" style="background-color:#FFFFFF;padding:32px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:640px;margin:0 auto;background-color:#0C2238;border:1px solid #1E3D5C;border-radius:14px;overflow:hidden;">

                    <tr>
                        <td height="4" bgcolor="#C5A05A" style="height:4px;background-color:#C5A05A;font-size:0;line-height:0;">&nbsp;</td>
                    </tr>

                    <tr>
                        <td align="center" bgcolor="#002147" style="background-color:#002147;padding:32px 28px 28px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto 18px;">
                                <tr>
                                    <td bgcolor="#FFFFFF" style="background-color:#FFFFFF;border-radius:12px;padding:10px 14px;">
                                        <img src="@($"{Model.ApiUrl}/assets/images/hornscope-logo.png")"
                                             alt="HornScope"
                                             width="168"
                                             style="display:block;width:168px;max-width:100%;height:auto;border:0;" />
                                    </td>
                                </tr>
                            </table>
                            <div style="font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#C5A05A;margin-bottom:8px;">
                                HornScope
                            </div>
                            <div style="font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1.35;font-weight:700;color:#D4B86A;text-align:center;">
                                Verify Email
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#0C2238" style="background-color:#0C2238;padding:32px 36px 24px;font-size:15px;line-height:1.7;color:#E8EEF4;">
                            <p style="margin:0 0 16px;color:#E8EEF4;">Hi @Model.Name,</p>
                            <p style="margin:0 0 16px;color:#B8C5D0;">
                                To activate your <strong style="color:#E8EEF4;">HornScope</strong> account, please verify your email address.
                                Your account will not be created until your email address is confirmed.
                            </p>
                            <p style="margin:0 0 8px;color:#B8C5D0;">
                                Temporary password:
                                <strong style="color:#D4B86A;">@Model.Password</strong>
                            </p>

                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:24px auto;">
                                <tr>
                                    <td align="center" bgcolor="#C5A05A" style="background-color:#C5A05A;border-radius:10px;">
                                        <a href="@Model.EmailConfirmationUrl"
                                           style="display:inline-block;padding:14px 28px;background-color:#C5A05A;color:#002147;text-decoration:none;font-weight:700;font-size:15px;letter-spacing:0.02em;border-radius:10px;">
                                            Confirm Your Email
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td bgcolor="#061525" style="background-color:#061525;padding:22px 36px 28px;border-top:1px solid #1E3D5C;font-size:14px;">
                            <p style="margin:0 0 4px;color:#8FA3B5;">Sincerely,</p>
                            <p style="margin:0;color:#D4B86A;font-weight:700;">HornScope - Platform Administration</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
